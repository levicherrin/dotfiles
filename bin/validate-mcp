#!/usr/bin/env python3
"""validate-mcp: Reusable Model Context Protocol (MCP) server validator.

Connects to MCP servers defined in configuration files over stdio, performs the
JSON-RPC 2.0 handshake, queries registered tools, and verifies tool scope.
"""

import argparse
import json
import os
import subprocess
import sys
from typing import Any, Dict, List, Optional

DEFAULT_CONFIG_PATHS = [
    os.path.expanduser("~/.gemini/config/mcp_config.json"),
    os.path.expanduser("~/.kiro/mcp_config.json"),
]


def find_config(custom_path: Optional[str] = None) -> Optional[str]:
    if custom_path:
        return os.path.abspath(custom_path) if os.path.exists(custom_path) else None
    for p in DEFAULT_CONFIG_PATHS:
        if os.path.exists(p):
            return p
    return None


def validate_server(name: str, srv: Dict[str, Any], verbose: bool = False) -> bool:
    print(f"=== Testing MCP Server: {name} ===")

    command = srv.get("command")
    if not command:
        print(f"Error: No command specified for server '{name}'.", file=sys.stderr)
        return False

    args = srv.get("args", [])
    env = os.environ.copy()
    env.update(srv.get("env", {}))

    cmd = [command] + args
    print(f"Command: {' '.join(cmd)}")

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            text=True,
        )

        # Step 1: Send initialize request
        init_req = {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2024-11-05",
                "capabilities": {},
                "clientInfo": {"name": "mcp-validator", "version": "1.0"},
            },
        }
        proc.stdin.write(json.dumps(init_req) + "\n")
        proc.stdin.flush()

        raw_init_resp = proc.stdout.readline()
        if not raw_init_resp:
            _, err = proc.communicate(timeout=2)
            print(f"Failed: Server closed stream without responding. Stderr: {err.strip()}", file=sys.stderr)
            return False

        init_resp = json.loads(raw_init_resp)
        if "error" in init_resp:
            print(f"Server Error during initialize: {init_resp['error']}", file=sys.stderr)
            proc.terminate()
            return False

        server_info = init_resp.get("result", {}).get("serverInfo", {})
        server_name = server_info.get("name", "unknown")
        server_version = server_info.get("version", "unknown")
        print(f"Status: Connected (Server: {server_name} v{server_version})")

        # Step 2: Send initialized notification
        proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        proc.stdin.flush()

        # Step 3: Query registered tools
        tools_req = {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}
        proc.stdin.write(json.dumps(tools_req) + "\n")
        proc.stdin.flush()

        raw_tools_resp = proc.stdout.readline()
        proc.terminate()

        if not raw_tools_resp:
            print("Failed: Server closed stream before returning tools/list.", file=sys.stderr)
            return False

        tools_resp = json.loads(raw_tools_resp)
        if "error" in tools_resp:
            print(f"Server Error during tools/list: {tools_resp['error']}", file=sys.stderr)
            return False

        tools = tools_resp.get("result", {}).get("tools", [])
        print(f"Tools Registered: {len(tools)}")

        for t in sorted(tools, key=lambda x: x.get("name", "")):
            tool_name = t.get("name", "")
            description = t.get("description", "")
            if verbose and description:
                print(f"  - {tool_name}: {description.splitlines()[0]}")
            else:
                print(f"  - {tool_name}")

        return True

    except FileNotFoundError:
        print(f"Failed: Command '{command}' not found in PATH.", file=sys.stderr)
        return False
    except Exception as e:
        print(f"Failed with exception: {e}", file=sys.stderr)
        return False


def main():
    parser = argparse.ArgumentParser(
        description="Validate MCP servers defined in mcp_config.json over stdio."
    )
    parser.add_argument(
        "server",
        nargs="?",
        help="Specific server name to test (tests all if omitted)",
    )
    parser.add_argument(
        "--config",
        "-c",
        help="Path to mcp_config.json (defaults to ~/.gemini/config/mcp_config.json)",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Show tool descriptions alongside names",
    )

    args = parser.parse_args()

    config_path = find_config(args.config)
    if not config_path:
        print("Error: No valid mcp_config.json found.", file=sys.stderr)
        print(f"Checked paths: {DEFAULT_CONFIG_PATHS}", file=sys.stderr)
        sys.exit(1)

    print(f"Loading configuration from: {config_path}")
    with open(config_path, "r") as f:
        try:
            config = json.load(f)
        except Exception as e:
            print(f"Error parsing JSON from {config_path}: {e}", file=sys.stderr)
            sys.exit(1)

    servers = config.get("mcpServers", {})
    if not servers:
        print("No mcpServers defined in configuration.")
        return

    if args.server:
        if args.server not in servers:
            print(f"Error: Server '{args.server}' not found in configuration.", file=sys.stderr)
            print(f"Available servers: {list(servers.keys())}", file=sys.stderr)
            sys.exit(1)
        target_servers = {args.server: servers[args.server]}
    else:
        target_servers = servers

    all_passed = True
    for name, srv in target_servers.items():
        ok = validate_server(name, srv, verbose=args.verbose)
        if not ok:
            all_passed = False
        print()

    if not all_passed:
        sys.exit(1)


if __name__ == "__main__":
    main()
